{
 "schema": 1,
 "recipes": [
  {
   "id": "chemscript-structure-properties",
   "title": "Formula, masses and InChI of a structure",
   "tool": "execute_chemscript_sdk",
   "platforms": ["win", "mac"],
   "verified_on": "22.2.0/win, 26.0/mac",
   "members": ["StructureData.LoadData", "StructureData.Formula", "StructureData.Weight", "StructureData.ExactMass", "StructureData.Inchi"],
   "program": [
    {"op": "call_static", "type": "StructureData", "member": "LoadData", "args": ["c1ccc(O)cc1", "chemical/x-smiles"], "as": "mol"},
    {"op": "call", "target": "mol", "member": "Formula"},
    {"op": "get", "target": "mol", "member": "Weight"},
    {"op": "get", "target": "mol", "member": "ExactMass"},
    {"op": "get", "target": "mol", "member": "Inchi"}
   ],
   "expect": [
    {"step": 0, "type": "StructureData"},
    {"step": 1, "equals": "C6H6O"},
    {"step": 2, "approx": 94.113, "tolerance": 0.01},
    {"step": 3, "approx": 94.0419, "tolerance": 0.001},
    {"step": 4, "equals": "InChI=1S/C6H6O/c7-6-4-2-1-3-5-6/h1-5,7H"}
   ]
  },
  {
   "id": "chemscript-name-and-lipophilicity",
   "title": "Systematic name, log P, refractivity and charge of a structure",
   "tool": "execute_chemscript_sdk",
   "platforms": ["win"],
   "verified_on": "22.2.0/win",
   "members": ["StructureData.ChemicalName", "StructureData.PartitionCoefficient", "StructureData.Refractivity", "StructureData.TotalCharge"],
   "program": [
    {"op": "call_static", "type": "StructureData", "member": "LoadData", "args": ["CC(=O)Nc1ccc(O)cc1", "chemical/x-smiles"], "as": "mol"},
    {"op": "call", "target": "mol", "member": "ChemicalName"},
    {"op": "get", "target": "mol", "member": "PartitionCoefficient"},
    {"op": "get", "target": "mol", "member": "Refractivity"},
    {"op": "get", "target": "mol", "member": "TotalCharge"}
   ],
   "expect": [
    {"step": 1, "equals": "N-(4-hydroxyphenyl)acetamide"},
    {"step": 2, "approx": 0.494, "tolerance": 0.01},
    {"step": 3, "approx": 4.1737, "tolerance": 0.01},
    {"step": 4, "equals": 0}
   ]
  },
  {
   "id": "chemscript-cleanup-to-cdxml",
   "title": "Clean up a structure and write it as CDXML text",
   "tool": "execute_chemscript_sdk",
   "platforms": ["win", "mac"],
   "verified_on": "22.2.0/win, 26.0/mac",
   "members": ["StructureData.CleanupStructure", "StructureData.WriteData"],
   "program": [
    {"op": "call_static", "type": "StructureData", "member": "LoadData", "args": ["OC(=O)c1ccccc1", "chemical/x-smiles"], "as": "mol"},
    {"op": "call", "target": "mol", "member": "CleanupStructure"},
    {"op": "call", "target": "mol", "member": "WriteData", "args": ["chemical/x-cdxml"]}
   ],
   "expect": [
    {"step": 1, "equals": true},
    {"step": 2, "contains": "<CDXML"}
   ]
  },
  {
   "id": "chemscript-common-substructure",
   "title": "Largest common substructure of two molecules",
   "tool": "execute_chemscript_sdk",
   "platforms": ["win", "mac"],
   "verified_on": "22.2.0/win, 26.0/mac",
   "members": ["LargestCommonSubstructure.Compute", "LargestCommonSubstructure.CommonSubstructure", "StructureData.Formula"],
   "program": [
    {"op": "call_static", "type": "StructureData", "member": "LoadData", "args": ["CCCO", "chemical/x-smiles"], "as": "a"},
    {"op": "call_static", "type": "StructureData", "member": "LoadData", "args": ["CCCN", "chemical/x-smiles"], "as": "b"},
    {"op": "call_static", "type": "LargestCommonSubstructure", "member": "Compute", "args": [{"$ref": "a"}, {"$ref": "b"}], "as": "lcs"},
    {"op": "call", "target": "lcs", "member": "CommonSubstructure", "as": "common"},
    {"op": "call", "target": "common", "member": "Formula"}
   ],
   "expect": [
    {"step": 2, "type": "LargestCommonSubstructure"},
    {"step": 4, "equals": "C3H8"}
   ]
  },
  {
   "id": "chemscript-reaction-species",
   "title": "Read the reactants of a reaction",
   "tool": "execute_chemscript_sdk",
   "platforms": ["win", "mac"],
   "verified_on": "22.2.0/win, 26.0/mac",
   "members": ["ReactionData.LoadData", "ReactionData.Reactants", "StructureData.Formula"],
   "program": [
    {"op": "call_static", "type": "ReactionData", "member": "LoadData", "args": ["CCO>>CC=O", "chemical/x-smiles"], "as": "rxn"},
    {"op": "get", "target": "rxn", "member": "Reactants", "as": "reactants"},
    {"op": "get_index", "target": "reactants", "index": 0, "as": "first"},
    {"op": "call", "target": "first", "member": "Formula"}
   ],
   "expect": [
    {"step": 0, "type": "ReactionData"},
    {"step": 3, "equals": "C2H6O"}
   ]
  },
  {
   "id": "com-open-and-inspect-document",
   "title": "Open a CDXML file and read the application and document",
   "tool": "chemdraw_com_call",
   "layer": "com",
   "platforms": [
    "win"
   ],
   "verified_on": "22.2.0/win",
   "members": [
    "IChemDrawApplication.name",
    "IChemDrawDocuments.Open",
    "IChemDrawDocuments.Count",
    "IChemDrawDocuments.Item",
    "IChemDrawDocument.name",
    "IChemDrawDocument.Saved"
   ],
   "fixture": "<?xml version=\"1.0\" encoding=\"UTF-8\" ?>\n<!DOCTYPE CDXML SYSTEM \"http://www.cambridgesoft.com/xml/cdxml.dtd\" >\n<CDXML BondLength=\"14.4\" LineWidth=\"0.6\" BoldWidth=\"2\" MarginWidth=\"1.6\"><page id=\"1\" BoundingBox=\"0 0 200 200\"><fragment id=\"2\"><n id=\"3\" p=\"100 100\"/><n id=\"4\" p=\"114.4 108.3\"/><n id=\"5\" p=\"128.8 100\" Element=\"8\"/><b id=\"6\" B=\"3\" E=\"4\"/><b id=\"7\" B=\"4\" E=\"5\"/></fragment></page></CDXML>\n",
   "program": [
    {
     "op": "get",
     "member": "name"
    },
    {
     "op": "get",
     "member": "Documents",
     "as": "docs"
    },
    {
     "op": "call",
     "target": "docs",
     "member": "Open",
     "args": [
      "{fixture}"
     ],
     "as": "doc"
    },
    {
     "op": "get",
     "target": "docs",
     "member": "Count"
    },
    {
     "op": "call",
     "target": "docs",
     "member": "Item",
     "args": [
      1
     ],
     "as": "first"
    },
    {
     "op": "get",
     "target": "first",
     "member": "name"
    },
    {
     "op": "get",
     "target": "first",
     "member": "Saved"
    }
   ],
   "expect": [
    {
     "step": 0,
     "contains": "ChemDraw"
    },
    {
     "step": 2,
     "object": "IChemDrawDocument"
    },
    {
     "step": 3,
     "at_least": 1
    },
    {
     "step": 4,
     "object": "IChemDrawDocument"
    },
    {
     "step": 5,
     "equals": "fixture.cdxml"
    },
    {
     "step": 6,
     "kind": "bool"
    }
   ]
  },
